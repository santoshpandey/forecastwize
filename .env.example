# Copy to .env and fill in local values. Never commit .env.
# See docs/security.md. No real secrets belong in this file.

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API (allowlist).
CORS_ORIGINS=http://localhost:3000

# Backend bind (used by local run scripts; Docker uses compose ports).
API_HOST=127.0.0.1
API_PORT=8000

# Frontend public API base (browser). Not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional until an LLM-backed agent is wired. Leave empty to start the app.
# The orchestrator does not call a vendor LLM today.
OPENAI_API_KEY=

# Max CSV upload size in bytes (POST /datasets). Also enforced via Content-Length.
MAX_UPLOAD_BYTES=10485760

# Max concurrent background agent runs + evaluation jobs (429 when exceeded).
MAX_INFLIGHT_JOBS=4

# Optional override for API file records (datasets, forecasts, runs, evaluations).
# Default is <repo>/data/api when the evaluation/ directory exists beside the repo.
# API_STORE_DIR=
